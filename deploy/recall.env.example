# RightToken recall deployment variables.
# Copy this file to recall.env on the server and replace every CHANGE_ME value.
# Compose maps RECALL_* names to the application variables used by recall-admin.

RECALL_IMAGE=ghcr.io/judehashbrown/righttoken-recall:CHANGE_ME_SHA
RECALL_SERVER_PORT=3000
RECALL_RIGHTTOKEN_NETWORK_NAME=deploy_sub2api-network
RECALL_DATABASE_URL=postgresql://righttoken_recall_app:CHANGE_ME_PASSWORD@postgres:5432/sub2api?schema=recall
RECALL_JOB_DATABASE_URL=postgresql://righttoken_recall_app:CHANGE_ME_PASSWORD@postgres:5432/sub2api

RECALL_SESSION_COOKIE_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
RECALL_APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY
RECALL_APP_URL=https://recall.righttoken.ai
RECALL_AUTH_MODE=righttoken
RECALL_INTERNAL_API_SECRET_CURRENT=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
RECALL_INTERNAL_API_SECRET_PREVIOUS=

RECALL_RIGHTTOKEN_ISSUER=https://righttoken.ai
RECALL_RIGHTTOKEN_AUDIENCE=righttoken-recall
# Must exactly match RECALL_SSO_SSO_SECRET on the RightToken main-site service.
RECALL_RIGHTTOKEN_SSO_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
RECALL_RIGHTTOKEN_ADMIN_URL=https://righttoken.ai/user-operations
RECALL_RIGHTTOKEN_DASHBOARD_URL=https://righttoken.ai/dashboard
RECALL_GEOIP_HTTP_URL=
RECALL_GEOIP_HTTP_TOKEN=
RECALL_GEOIP_HTTP_TIMEOUT_MS=2000
RECALL_GEOIP_MMDB_PATH=/var/lib/righttoken-geoip/GeoLite2-City.mmdb
RECALL_GEOIP_RIR_PATH=/var/lib/righttoken-geoip/delegated-rir.txt
RECALL_RECONCILE_ENABLED=true
RECALL_RECONCILE_INTERVAL_MINUTES=5
RECALL_FULL_RECONCILE_CRON=0 2 * * *

RECALL_SMTP_HOST=
RECALL_SMTP_PORT=
RECALL_SMTP_SECURE=false
RECALL_SMTP_USER=
RECALL_SMTP_PASSWORD=
RECALL_IMAP_HOST=
RECALL_IMAP_PORT=
RECALL_IMAP_SECURE=false
RECALL_IMAP_USER=
RECALL_IMAP_PASSWORD=
RECALL_WECHAT_WEBHOOK_URL=
RECALL_NOTIFICATION_FROM=

RECALL_BOOTSTRAP_PRIMARY_ADMIN_EMAIL=
RECALL_BOOTSTRAP_PRIMARY_ADMIN_NAME=主管理员
