# RightToken recall deployment variables.
# Copy this file to recall.env on the server and replace every CHANGE_ME value.
# Compose maps RECALL_* names to the application variables used by recall-admin.

RECALL_IMAGE=ghcr.io/judehashbrown/righttoken-recall:CHANGE_ME_SHA
RECALL_SERVER_PORT=3000
RECALL_POSTGRES_DB=righttoken_recall
RECALL_POSTGRES_USER=righttoken_recall
RECALL_POSTGRES_PASSWORD=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
RECALL_DATABASE_URL=postgresql://righttoken_recall:CHANGE_ME_PASSWORD@recall-db:5432/righttoken_recall
RECALL_JOB_DATABASE_URL=postgresql://righttoken_recall:CHANGE_ME_PASSWORD@recall-db:5432/righttoken_recall

RECALL_SESSION_COOKIE_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
RECALL_APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY
RECALL_APP_URL=https://recall.righttoken.ai
RECALL_AUTH_MODE=standalone
RECALL_INTERNAL_API_SECRET_CURRENT=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
RECALL_INTERNAL_API_SECRET_PREVIOUS=

RECALL_RIGHTTOKEN_ISSUER=
RECALL_RIGHTTOKEN_AUDIENCE=
RECALL_RIGHTTOKEN_JWKS_URL=
RECALL_RIGHTTOKEN_ROLE_MAP=
RECALL_RIGHTTOKEN_API_BASE_URL=
RECALL_RIGHTTOKEN_API_TOKEN=
RECALL_RECONCILE_ENABLED=false
RECALL_RECONCILE_INTERVAL_MINUTES=15
RECALL_FULL_RECONCILE_CRON=0 2 * * *

RECALL_SMTP_HOST=
RECALL_SMTP_PORT=
RECALL_SMTP_SECURE=false
RECALL_SMTP_USER=
RECALL_SMTP_PASSWORD=
RECALL_IMAP_HOST=
RECALL_IMAP_PORT=
RECALL_IMAP_SECURE=false
RECALL_IMAP_USER=
RECALL_IMAP_PASSWORD=
RECALL_WECHAT_WEBHOOK_URL=
RECALL_NOTIFICATION_FROM=

RECALL_BOOTSTRAP_PRIMARY_ADMIN_EMAIL=
RECALL_BOOTSTRAP_PRIMARY_ADMIN_PASSWORD=
RECALL_BOOTSTRAP_PRIMARY_ADMIN_NAME=主管理员
