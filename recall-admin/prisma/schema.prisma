generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["recall"]
}

enum MemberRole {
  PRIMARY_ADMIN
  ADMIN
  OPERATOR

  @@schema("recall")
}

enum SegmentCode {
  A
  B
  C
  D
  E
  F
  G

  @@schema("recall")
}

enum TaskPriority {
  URGENT
  IMPORTANT
  NORMAL

  @@schema("recall")
}

enum TaskStatus {
  UNASSIGNED
  TODO
  IN_PROGRESS
  WAITING_USER
  COMPLETED
  PAUSED
  CANCELLED

  @@schema("recall")
}

enum TaskOrigin {
  AUTOMATION
  MANUAL
  EMAIL_REPLY

  @@schema("recall")
}

enum MailDirection {
  OUTBOUND
  INBOUND

  @@schema("recall")
}

enum MailMessageStatus {
  DRAFT
  SENT
  BOUNCED
  RECEIVED
  FAILED
  UNMATCHED

  @@schema("recall")
}

enum MailDeliveryAction {
  FAILED
  DELAYED
  DELIVERED
  OTHER

  @@schema("recall")
}

enum MailAssetDisposition {
  INLINE
  ATTACHMENT

  @@schema("recall")
}

enum MailAudienceMode {
  USER
  SEGMENT
  ALL

  @@schema("recall")
}

enum MailBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILURE
  FAILED

  @@schema("recall")
}

enum MailBatchRecipientStatus {
  PENDING
  SENDING
  SENT
  BOUNCED
  SKIPPED
  FAILED

  @@schema("recall")
}

enum NotificationChannel {
  IN_APP
  WECOM_APP
  WECOM_ROBOT
  EMAIL

  @@schema("recall")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTER

  @@schema("recall")
}

enum RecalculationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILURE
  FAILED

  @@schema("recall")
}

enum LocationAttributionSource {
  EMAIL_EXACT_DOMAIN
  EMAIL_DOMAIN_SUFFIX
  IP_GEOIP
  IP_RIR
  IP_EVENT
  INVALID_REGISTRATION_DATA

  @@schema("recall")
}

enum LocationRuleMatchType {
  EXACT_DOMAIN
  DOMAIN_SUFFIX

  @@schema("recall")
}

enum LocationAssignmentMode {
  AUTO
  MANUAL

  @@schema("recall")
}

enum OwnerAssignmentMode {
  AUTO
  MANUAL

  @@schema("recall")
}

model Member {
  id               String     @id @default(cuid())
  email            String     @unique
  rightTokenUserId String?    @unique
  displayName      String
  passwordHash     String
  role             MemberRole
  active           Boolean    @default(true)
  twoFactorSecret  String?
  twoFactorOn      Boolean    @default(false)
  wecomUserId      String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions                    Session[]
  assignedTasks               RecallTask[]                 @relation("TaskAssignee")
  ownedUsers                  UserProfile[]                @relation("UserOwner")
  notes                       UserNote[]
  auditLogs                   AuditLog[]                   @relation("AuditActor")
  recoveryCodes               RecoveryCode[]
  reviewedMailMessages        MailMessage[]                @relation("MailReviewer")
  segmentRecalculationRuns    SegmentRecalculationRun[]    @relation("SegmentRecalculationRequester")
  locationRecalculationRuns   LocationRecalculationRun[]   @relation("LocationRecalculationRequester")
  assignmentRecalculationRuns AssignmentRecalculationRun[] @relation("AssignmentRecalculationRequester")
  ownerAssignmentsMade        UserProfile[]                @relation("UserOwnerAssigner")
  locationAssignmentsMade     UserProfile[]                @relation("UserLocationAssigner")
  createdMailBatches          MailBatch[]                  @relation("MailBatchCreator")

  @@schema("recall")
}

model SsoTicketRedemption {
  jti        String   @id
  expiresAt  DateTime
  redeemedAt DateTime @default(now())

  @@index([expiresAt])
  @@schema("recall")
}

model Session {
  id                     String    @id @default(cuid())
  memberId               String
  tokenHash              String    @unique
  expiresAt              DateTime
  reauthenticatedAt      DateTime?
  secondFactorRequired   Boolean   @default(false)
  secondFactorVerifiedAt DateTime?
  createdAt              DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, expiresAt])
  @@schema("recall")
}

model UserProfile {
  id                         String                     @id @default(cuid())
  externalUserId             String                     @unique
  email                      String
  emailNormalized            String
  displayName                String?
  registeredAt               DateTime
  registrationIpEnc          String?
  registrationIpHash         String?
  countryCode                String?
  region                     String?
  ipCountryCode              String?
  ipRegion                   String?
  locationSource             LocationAttributionSource?
  locationRuleId             String?
  locationEvaluatedAt        DateTime?
  locationAssignmentMode     LocationAssignmentMode     @default(AUTO)
  locationAssignedAt         DateTime?
  locationAssignedById       String?
  locationAssignmentReason   String?
  language                   String?
  timezone                   String?
  source                     String?
  checkoutStartedAt          DateTime?
  checkoutChangedAt          DateTime?
  paymentStatus              String                     @default("NONE")
  firstPaidAt                DateTime?
  totalPaidMinor             Int                        @default(0)
  firstCallAt                DateTime?
  lastCallAt                 DateTime?
  successfulCallCount        Int                        @default(0)
  balanceMinor               Int                        @default(0)
  balanceCurrency            String                     @default("USD")
  balanceUsdMinor            Int                        @default(0)
  balanceChangedAt           DateTime?
  anomalyActive              Boolean                    @default(false)
  anomalyChangedAt           DateTime?
  anomalyErrorPhase          String?
  anomalyErrorType           String?
  anomalyErrorMessage        String?
  anomalyErrorOwner          String?
  anomalyStatusCode          Int?
  anomalyModel               String?
  anomalyPlatform            String?
  anomalyRequestCount        Int?
  anomalyFailureCount        Int?
  anomalyConsecutiveFailures Int?
  anomalyLastOccurredAt      DateTime?
  currentSegment             SegmentCode
  segmentRuleVersion         Int                        @default(1)
  ownerId                    String?
  ownerAssignmentMode        OwnerAssignmentMode        @default(AUTO)
  ownerAssignedAt            DateTime?
  ownerAssignedById          String?
  ownerAssignmentReason      String?
  reasonLabel                String?
  unsubscribedAt             DateTime?
  pausedAt                   DateTime?
  profileChangedAt           DateTime?
  lastExternalEventAt        DateTime?
  sourceDeletedAt            DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  owner               Member?                  @relation("UserOwner", fields: [ownerId], references: [id])
  ownerAssignedBy     Member?                  @relation("UserOwnerAssigner", fields: [ownerAssignedById], references: [id], onDelete: SetNull)
  events              UserEvent[]
  segmentHistory      SegmentHistory[]
  segmentOverrides    SegmentOverride[]
  tasks               RecallTask[]
  notes               UserNote[]
  mailThreads         MailThread[]
  mailMessages        MailMessage[]
  mailBatchRecipients MailBatchRecipient[]
  locationRule        LocationAttributionRule? @relation(fields: [locationRuleId], references: [id], onDelete: SetNull)
  locationAssignedBy  Member?                  @relation("UserLocationAssigner", fields: [locationAssignedById], references: [id], onDelete: SetNull)

  @@index([currentSegment, updatedAt])
  @@index([currentSegment, sourceDeletedAt, registeredAt], map: "UserProfile_recent_unpaid_idx")
  @@index([currentSegment, anomalyActive, sourceDeletedAt, anomalyLastOccurredAt], map: "UserProfile_recent_anomaly_occurred_idx")
  @@index([currentSegment, anomalyActive, sourceDeletedAt, anomalyChangedAt], map: "UserProfile_recent_anomaly_changed_idx")
  @@index([countryCode, region])
  @@index([ipCountryCode, ipRegion])
  @@index([locationRuleId])
  @@index([locationAssignmentMode, countryCode, region])
  @@index([ownerAssignmentMode, ownerId])
  @@index([emailNormalized])
  @@index([sourceDeletedAt])
  @@schema("recall")
}

model UserEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  userId     String
  eventType  String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  payload    Json
  applied    Boolean  @default(false)
  errorCode  String?

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@schema("recall")
}

model SiteVisit {
  id          String   @id @default(cuid())
  eventId     String   @unique
  occurredAt  DateTime
  visitDate   DateTime @db.Date
  visitorHash String
  countryCode String   @default("ZZ")
  region      String?
  path        String
  createdAt   DateTime @default(now())

  @@index([visitDate, visitorHash])
  @@index([visitDate, countryCode])
  @@index([visitDate, countryCode, region])
  @@schema("recall")
}

model SegmentHistory {
  id          String       @id @default(cuid())
  userId      String
  fromSegment SegmentCode?
  toSegment   SegmentCode
  ruleVersion Int
  reason      String
  changedAt   DateTime     @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@schema("recall")
}

model SegmentOverride {
  id          String      @id @default(cuid())
  userId      String
  segment     SegmentCode
  reason      String
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@schema("recall")
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  author Member      @relation(fields: [authorId], references: [id])

  @@index([userId, createdAt])
  @@schema("recall")
}

model AutomationRuleVersion {
  id          String   @id @default(cuid())
  kind        String
  version     Int
  config      Json
  active      Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  recalculationRuns SegmentRecalculationRun[]

  @@unique([kind, version])
  @@index([kind, active])
  @@schema("recall")
}

model SegmentRecalculationRun {
  id                  String              @id @default(cuid())
  ruleVersionId       String
  ruleVersionNumber   Int
  requestedById       String
  idempotencyKey      String              @unique
  status              RecalculationStatus @default(PENDING)
  totalUsers          Int                 @default(0)
  processedUsers      Int                 @default(0)
  succeededUsers      Int                 @default(0)
  failedUsers         Int                 @default(0)
  segmentChanges      Int                 @default(0)
  cancelledTasks      Int                 @default(0)
  createdTasks        Int                 @default(0)
  lastProcessedUserId String?
  upperBoundUserId    String?
  previewSummary      Json
  errorSummary        Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  ruleVersion AutomationRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  requestedBy Member                @relation("SegmentRecalculationRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([ruleVersionId, createdAt])
  @@schema("recall")
}

model AssignmentRule {
  id                     String    @id @default(cuid())
  name                   String
  enabled                Boolean   @default(true)
  memberTerritoryManaged Boolean   @default(false)
  priority               Int
  conditions             Json
  assigneeId             String?
  fallbackAssigneeId     String?
  poolKey                String?
  workloadLimit          Int?
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([priority])
  @@index([enabled, priority])
  @@index([memberTerritoryManaged, assigneeId])
  @@schema("recall")
}

model AssignmentRecalculationRun {
  id                  String              @id @default(cuid())
  requestedById       String
  status              RecalculationStatus @default(PENDING)
  totalUsers          Int                 @default(0)
  processedUsers      Int                 @default(0)
  succeededUsers      Int                 @default(0)
  failedUsers         Int                 @default(0)
  ownerChanges        Int                 @default(0)
  reassignedTasks     Int                 @default(0)
  lastProcessedUserId String?
  upperBoundUserId    String?
  errorSummary        Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  requestedBy Member @relation("AssignmentRecalculationRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@schema("recall")
}

model LocationAttributionRule {
  id          String                @id @default(cuid())
  name        String
  enabled     Boolean               @default(true)
  priority    Int
  matchType   LocationRuleMatchType
  pattern     String
  countryCode String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  users UserProfile[]

  @@unique([priority])
  @@unique([matchType, pattern])
  @@index([enabled, matchType, priority])
  @@schema("recall")
}

model LocationRecalculationRun {
  id                  String              @id @default(cuid())
  requestedById       String
  status              RecalculationStatus @default(PENDING)
  totalUsers          Int                 @default(0)
  processedUsers      Int                 @default(0)
  succeededUsers      Int                 @default(0)
  failedUsers         Int                 @default(0)
  countryChanges      Int                 @default(0)
  reassignedTasks     Int                 @default(0)
  lastProcessedUserId String?
  upperBoundUserId    String?
  ruleSnapshot        Json
  errorSummary        Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  requestedBy Member @relation("LocationRecalculationRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@schema("recall")
}

model RecallTask {
  id               String       @id @default(cuid())
  userId           String
  origin           TaskOrigin
  triggerKey       String
  ruleVersion      Int
  title            String
  reason           String
  anomalySnapshot  Json?
  priority         TaskPriority
  status           TaskStatus   @default(UNASSIGNED)
  assigneeId       String?
  assignmentReason String?
  dueAt            DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user                UserProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee            Member?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  activities          TaskActivity[]
  mailMessages        MailMessage[]
  notificationIntents NotificationIntent[]
  mailBatchRecipients MailBatchRecipient[]

  @@unique([userId, triggerKey, ruleVersion])
  @@index([status, priority, dueAt])
  @@index([assigneeId, status])
  @@schema("recall")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  task RecallTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@schema("recall")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json
  ipHash     String?
  createdAt  DateTime @default(now())

  actor Member? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@schema("recall")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, ipHash, createdAt])
  @@schema("recall")
}

model Invitation {
  id          String     @id @default(cuid())
  email       String
  role        MemberRole
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, expiresAt])
  @@schema("recall")
}

model RecoveryCode {
  id        String    @id @default(cuid())
  memberId  String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, usedAt])
  @@schema("recall")
}

model Mailbox {
  id                     String    @id @default(cuid())
  name                   String
  emailAddress           String    @unique
  encryptedConfig        String?
  configurationDeletedAt DateTime?
  configurationVersion   Int       @default(1)
  enabled                Boolean   @default(false)
  trackingEnabled        Boolean   @default(false)
  trackingDisclosure     String?
  lastSyncedAt           DateTime?
  lastTestedAt           DateTime?
  lastSuccessAt          DateTime?
  lastErrorCode          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  threads        MailThread[]
  messages       MailMessage[]
  mailBatches    MailBatch[]
  deliveryEvents MailDeliveryEvent[]

  @@index([configurationDeletedAt, enabled])
  @@schema("recall")
}

model MailTemplate {
  id           String       @id @default(cuid())
  key          String
  version      Int
  name         String
  locale       String       @default("zh-CN")
  subject      String
  bodyText     String
  bodyHtml     String?
  segment      SegmentCode?
  active       Boolean      @default(false)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?
  archivedById String?

  assets MailTemplateAsset[]

  @@unique([key, version])
  @@index([active, archivedAt, segment, locale])
  @@schema("recall")
}

model MailThread {
  id        String   @id @default(cuid())
  userId    String
  mailboxId String
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailbox  Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messages MailMessage[]

  @@index([userId, updatedAt])
  @@index([mailboxId, updatedAt])
  @@schema("recall")
}

model MailMessage {
  id                    String            @id @default(cuid())
  mailboxId             String
  threadId              String?
  userId                String?
  taskId                String?
  direction             MailDirection
  status                MailMessageStatus
  providerMessageId     String?           @unique
  inReplyTo             String?
  references            String[]
  fromAddress           String
  toAddresses           String[]
  subject               String
  bodyText              String
  bodyHtml              String?
  templateKey           String?
  templateVersion       Int?
  reviewedById          String?
  openedAt              DateTime?
  firstClickedAt        DateTime?
  openCount             Int               @default(0)
  clickCount            Int               @default(0)
  sentAt                DateTime?
  receivedAt            DateTime?
  bouncedAt             DateTime?
  bounceStatusCode      String?
  bounceDiagnostic      String?
  lastErrorCode         String?
  externalImagesBlocked Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  mailbox        Mailbox             @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  thread         MailThread?         @relation(fields: [threadId], references: [id], onDelete: SetNull)
  user           UserProfile?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  task           RecallTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewedBy     Member?             @relation("MailReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assets         MailMessageAsset[]
  batchRecipient MailBatchRecipient?
  deliveryEvents MailDeliveryEvent[]

  @@index([mailboxId, status, createdAt])
  @@index([threadId, createdAt])
  @@index([userId, createdAt])
  @@index([taskId])
  @@schema("recall")
}

model MailDeliveryEvent {
  id                       String             @id @default(cuid())
  mailboxId                String
  outboundMessageId        String
  inboundProviderMessageId String
  action                   MailDeliveryAction
  recipientNormalized      String
  statusCode               String?
  diagnosticCode           String?
  reportedAt               DateTime
  createdAt                DateTime           @default(now())

  mailbox         Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  outboundMessage MailMessage @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)

  @@unique([inboundProviderMessageId, recipientNormalized, action])
  @@index([mailboxId, reportedAt])
  @@index([outboundMessageId, reportedAt])
  @@schema("recall")
}

model MailAsset {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  fileName    String
  contentType String
  byteSize    Int
  sha256      String
  width       Int
  height      Int
  createdById String?
  createdAt   DateTime @default(now())

  templateUsages MailTemplateAsset[]
  messageUsages  MailMessageAsset[]
  batchUsages    MailBatchAsset[]

  @@index([createdById, createdAt])
  @@schema("recall")
}

model MailTemplateAsset {
  id          String               @id @default(cuid())
  templateId  String
  assetId     String
  disposition MailAssetDisposition
  cid         String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())

  template MailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  asset    MailAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([templateId, assetId, disposition])
  @@index([assetId])
  @@index([templateId, sortOrder])
  @@schema("recall")
}

model MailMessageAsset {
  id          String               @id @default(cuid())
  messageId   String
  assetId     String
  disposition MailAssetDisposition
  cid         String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())

  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset   MailAsset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([messageId, assetId, disposition])
  @@index([assetId])
  @@index([messageId, sortOrder])
  @@schema("recall")
}

model MailBatch {
  id                String           @id @default(cuid())
  mailboxId         String
  createdById       String
  audienceMode      MailAudienceMode
  segment           SegmentCode?
  subject           String
  bodyText          String
  bodyHtml          String
  idempotencyKey    String           @unique
  retryRootBatchId  String?
  status            MailBatchStatus  @default(PENDING)
  totalRecipients   Int              @default(0)
  pendingRecipients Int              @default(0)
  sentRecipients    Int              @default(0)
  skippedRecipients Int              @default(0)
  failedRecipients  Int              @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  mailbox    Mailbox              @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  createdBy  Member               @relation("MailBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recipients MailBatchRecipient[]
  assets     MailBatchAsset[]
  retryRoot  MailBatch?           @relation("MailBatchRetryRoot", fields: [retryRootBatchId], references: [id], onDelete: Restrict)
  retries    MailBatch[]          @relation("MailBatchRetryRoot")

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([retryRootBatchId, createdAt])
  @@schema("recall")
}

model MailBatchRecipient {
  id                 String                   @id @default(cuid())
  batchId            String
  userId             String
  emailNormalized    String
  status             MailBatchRecipientStatus @default(PENDING)
  reasonCode         String?
  messageId          String?                  @unique
  taskId             String?
  retryOfRecipientId String?                  @unique
  attempts           Int                      @default(0)
  claimedAt          DateTime?
  lastAttemptAt      DateTime?
  completedAt        DateTime?
  bouncedAt          DateTime?
  bounceStatusCode   String?
  bounceDiagnostic   String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  batch            MailBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user             UserProfile         @relation(fields: [userId], references: [id], onDelete: Restrict)
  message          MailMessage?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  task             RecallTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  retryOfRecipient MailBatchRecipient? @relation("MailRecipientRetry", fields: [retryOfRecipientId], references: [id], onDelete: Restrict)
  retryRecipient   MailBatchRecipient? @relation("MailRecipientRetry")

  @@unique([batchId, userId])
  @@index([batchId, status, id])
  @@index([retryOfRecipientId])
  @@schema("recall")
}

model MailDomainThrottle {
  senderDomain    String   @id
  nextAvailableAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nextAvailableAt])
  @@schema("recall")
}

model MailBatchAsset {
  id          String               @id @default(cuid())
  batchId     String
  assetId     String
  disposition MailAssetDisposition
  sortOrder   Int                  @default(0)

  batch MailBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset MailAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([batchId, assetId])
  @@index([assetId])
  @@index([batchId, sortOrder])
  @@schema("recall")
}

model SuppressionEntry {
  id              String   @id @default(cuid())
  emailNormalized String   @unique
  reason          String
  source          String
  createdAt       DateTime @default(now())

  @@schema("recall")
}

model NotificationIntent {
  id                String              @id @default(cuid())
  taskId            String?
  channel           NotificationChannel
  recipient         String
  payload           Json
  status            DeliveryStatus      @default(PENDING)
  attemptCount      Int                 @default(0)
  lastErrorCode     String?
  providerMessageId String?
  sentAt            DateTime?
  nextAttemptAt     DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  task RecallTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, channel, recipient])
  @@index([status, nextAttemptAt, createdAt])
  @@index([recipient, readAt, createdAt])
  @@schema("recall")
}

model IntegrationCredential {
  id              String    @id @default(cuid())
  kind            String    @unique
  displayName     String
  encryptedConfig String
  enabled         Boolean   @default(false)
  lastTestedAt    DateTime?
  lastSuccessAt   DateTime?
  lastErrorCode   String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@schema("recall")
}
