{
  "name": "righttoken-recall-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/worker/index.mjs",
    "worker:prod": "node dist/worker/index.mjs",
    "worker:health": "node --env-file-if-exists=.env scripts/worker-health.mjs",
    "bootstrap:build": "esbuild scripts/bootstrap-primary-admin.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/bootstrap-primary-admin.mjs",
    "initial-reconcile:build": "esbuild scripts/run-initial-reconcile.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/run-initial-reconcile.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test",
    "geoip:update": "node --import tsx scripts/update-rir-geoip.ts",
    "sync:initial": "node --env-file-if-exists=.env --import tsx scripts/run-initial-reconcile.ts",
    "sync:initial:prod": "node dist/run-initial-reconcile.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "tsx scripts/bootstrap-primary-admin.ts",
    "db:bootstrap-admin:prod": "node dist/bootstrap-primary-admin.mjs",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "date-fns": "^4.4.0",
    "imapflow": "^1.4.9",
    "lucide-react": "^1.25.0",
    "mailparser": "^3.9.14",
    "maxmind": "^5.0.6",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.2",
    "postcss": "^8.5.22",
    "prisma": "^7.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
